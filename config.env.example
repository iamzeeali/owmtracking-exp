# Copy to config.env (local dev) or config.docker.env (Docker)
#
# Local dev: spaces/quotes in config.env may work with dotenv.
# Docker: config.docker.env MUST be KEY=value only (no spaces, no quotes).
#
# Docker Compose sets DATABASE for the api service in docker-compose.yml:
#   mongodb://mongo:27017/owmInventory

NODE_ENV=development
PORT=5001
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
DATABASE=mongodb://localhost:27018/owmInventory
